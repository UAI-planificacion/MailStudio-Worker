{
    "name": "mail-studio-worker",
    "version": "1.0.0",
    "description": "Worker de Azure Functions para el envío de correos a través de Resend",
    "main": "dist/src/functions/*.js",
    "scripts": {
        "build": "tsc",
        "watch": "tsc -w",
